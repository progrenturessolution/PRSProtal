# Server Configuration
PORT=5000

# MongoDB Configuration
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/progrentures

# DNS resolvers used for MongoDB Atlas SRV records when the default resolver fails
MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/progrentures?retryWrites=true&w=majority

# JWT Secret Key
# IMPORTANT: Change this to a secure random string in production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

