# Server Configuration
PORT=5000

# MongoDB Configuration
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/progrentures

# For MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/progrentures?retryWrites=true&w=majority

# JWT Secret Key
# IMPORTANT: Change this to a secure random string in production
# You can generate one using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Email Configuration (SMTP - Hostinger/Gmail/others)
# For Hostinger:
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
# Optional: comma-separated fallback ports tried after SMTP_PORT (for hosts where 465/587 is blocked)
# SMTP_ALT_PORTS=587,2525
# Optional: disable startup verify in production to avoid noisy logs
# SMTP_VERIFY_ON_STARTUP=false
# Optional: set explicit TLS server name if host is behind a relay/load balancer
# SMTP_TLS_SERVERNAME=smtp.hostinger.com
EMAIL_USER=hello@yourdomain.com
EMAIL_PASS=your-smtp-password
